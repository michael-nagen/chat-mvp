# Secret used to sign and verify JWTs. Required — the app will not boot without it.
JWT_SECRET=replace-with-a-long-random-string

# OpenAI API key for the assistant. Read from env only, never logged, never
# committed. The app boots without it; it's required only when a completion is
# actually requested (e.g. the verify:assistant script's live call).
OPENAI_API_KEY=replace-with-your-openai-api-key

# Storage driver: "mongo" (persistent, default) or "memory" (process-local, no DB).
# "memory" boots with no Mongo connection — handy for fast tests.
STORAGE_DRIVER=mongo

# Embeddings provider for the Knowledge/RAG ingestion + retrieval: "openai"
# (default; uses OPENAI_API_KEY and text-embedding-3-small via LangChain) or
# "fake" (deterministic, no network/credentials — used by the test suite).
EMBEDDINGS_PROVIDER=openai

# RAG tutor retrieval implementation: "mock" (default; offline canned chunks so
# tests never hit the network) or "atlas" (real Atlas Vector Search over
# knowledge_chunks). Set to "atlas" in real dev once KNOWLEDGE_MONGO_URI points
# at Atlas and the vector index exists (npm run create:knowledge-index).
RAG_RETRIEVAL_PROVIDER=atlas

# RAG tutor answer generator: "langchain" (real LangChain ChatOpenAI, needs
# OPENAI_API_KEY; this is the default for any non-"fake" value) or "fake"
# (deterministic, no credentials — used by tests).
RAG_TUTOR_PROVIDER=langchain

# Minimum cosine similarity (0..1) for a retrieved chunk to count as grounding
# context and become a citation. Default 0.65. Higher than 0.5 on purpose:
# text-embedding-3-small scores unrelated short text ~0.5-0.58, so 0.5 lets
# off-topic questions cite whatever chunk exists; 0.65 makes them fall back to
# "not found" while still keeping genuinely relevant chunks (which score ~0.8+).
RAG_TUTOR_MIN_SCORE=0.65

# MongoDB connection for the MAIN app data (users, conversations, messages,
# auth — everything except Knowledge/RAG). Required under the mongo driver — the
# app will not boot without it. Must point at a replica set (replicaSet=rs0) so
# multi-document transactions work. Local single-node replica set via docker-compose:
MONGO_URI=mongodb://localhost:27017/chat?replicaSet=rs0&directConnection=true

# Dedicated MongoDB connection for the KNOWLEDGE/RAG data only (knowledge_documents
# + knowledge_chunks). Point this at MongoDB Atlas.
#   - MONGO_URI holds the MAIN app data; KNOWLEDGE_MONGO_URI holds Knowledge/RAG data.
#   - When unset, the Knowledge domain falls back to MONGO_URI so local dev keeps working.
#   - Real credentials go ONLY in .env (gitignored) — never in this file.
#   - Atlas Vector Search will later be created on knowledge_chunks.embedding
#     (see `npm run create:knowledge-index`).
# Verify the connection locally with: npm run verify:knowledge-mongo
KNOWLEDGE_MONGO_URI=mongodb+srv://<atlas-username>:<atlas-password>@<atlas-cluster-url>/<knowledge-database-name>?retryWrites=true&w=majority&appName=Cluster0

# Port the HTTP server listens on (optional, defaults to 3000).
PORT=3000

# Comma-separated list of allowed frontend origins for CORS (optional).
CORS_ORIGIN=http://localhost:5173

# Redis connection for persisting recent searches (optional).
# When unset or unreachable, recent searches fall back to an in-memory store.
REDIS_URL=redis://localhost:6379

# ── Avatar object storage ───────────────────────────────────────────────────
# Driver, independent of STORAGE_DRIVER: "s3" (real AWS, default) or "fake"
# (in-memory; no AWS needed — used by the test suite).
AVATAR_STORAGE=s3
# The following are required when AVATAR_STORAGE=s3.
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-avatars-bucket
# Credentials are read from the default AWS provider chain (env vars or an IAM role):
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Optional: override the public base URL (e.g. a CloudFront/CDN domain).
# Defaults to https://<bucket>.s3.<region>.amazonaws.com
# AVATAR_PUBLIC_BASE_URL=https://cdn.example.com
#
# Bucket setup required for the presigned-PUT + public-read flow:
#   1. CORS: allow PUT (and the signed Content-Type header) from the frontend
#      origin(s) in CORS_ORIGIN, e.g. AllowedMethods=["PUT"],
#      AllowedOrigins=["http://localhost:5173"], AllowedHeaders=["*"].
#   2. Public read: grant s3:GetObject on arn:aws:s3:::<bucket>/avatars/* via a
#      bucket policy (objects are NOT made public via per-object ACLs).
#   3. App IAM principal needs s3:PutObject, s3:DeleteObject AND s3:GetObject on
#      arn:aws:s3:::<bucket>/avatars/* — GetObject is required for the commit-time
#      HeadObject existence/size check.
