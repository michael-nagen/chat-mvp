# Secret used to sign and verify JWTs. Required — the app will not boot without it.
JWT_SECRET=replace-with-a-long-random-string

# Storage driver: "mongo" (persistent, default) or "memory" (process-local, no DB).
# "memory" boots with no Mongo connection — handy for fast tests.
STORAGE_DRIVER=mongo

# MongoDB connection. Required under the mongo driver — the app will not boot without it.
# Must point at a replica set (replicaSet=rs0) so multi-document transactions work.
# Local single-node replica set via docker-compose:
MONGO_URI=mongodb://localhost:27017/chat?replicaSet=rs0&directConnection=true

# Port the HTTP server listens on (optional, defaults to 3000).
PORT=3000

# Comma-separated list of allowed frontend origins for CORS (optional).
CORS_ORIGIN=http://localhost:5173

# Redis connection for persisting recent searches (optional).
# When unset or unreachable, recent searches fall back to an in-memory store.
REDIS_URL=redis://localhost:6379

# ── Avatar object storage ───────────────────────────────────────────────────
# Driver, independent of STORAGE_DRIVER: "s3" (real AWS, default) or "fake"
# (in-memory; no AWS needed — used by the test suite).
AVATAR_STORAGE=s3
# The following are required when AVATAR_STORAGE=s3.
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-avatars-bucket
# Credentials are read from the default AWS provider chain (env vars or an IAM role):
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Optional: override the public base URL (e.g. a CloudFront/CDN domain).
# Defaults to https://<bucket>.s3.<region>.amazonaws.com
# AVATAR_PUBLIC_BASE_URL=https://cdn.example.com
#
# Bucket setup required for the presigned-PUT + public-read flow:
#   1. CORS: allow PUT (and the signed Content-Type header) from the frontend
#      origin(s) in CORS_ORIGIN, e.g. AllowedMethods=["PUT"],
#      AllowedOrigins=["http://localhost:5173"], AllowedHeaders=["*"].
#   2. Public read: grant s3:GetObject on arn:aws:s3:::<bucket>/avatars/* via a
#      bucket policy (objects are NOT made public via per-object ACLs).
#   3. App IAM principal needs s3:PutObject, s3:DeleteObject AND s3:GetObject on
#      arn:aws:s3:::<bucket>/avatars/* — GetObject is required for the commit-time
#      HeadObject existence/size check.
